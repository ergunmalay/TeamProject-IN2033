# =====================================================
# IPOS-PU Database Configuration
# =====================================================
# Copy this file to db.properties (same directory) and fill in your local values.
# db.properties is gitignored — your credentials will NOT be committed.
#
# Setup instructions:
# 1. Install MySQL 8.0 locally
# 2. Create database:  CREATE DATABASE ipos_pu;
# 3. Create user:      CREATE USER 'ipospu_user'@'localhost' IDENTIFIED BY 'your_password';
# 4. Grant access:     GRANT ALL PRIVILEGES ON ipos_pu.* TO 'ipospu_user'@'localhost';
# 5. For cross-subsystem (10 marks), also grant READ on SA/CA schemas:
#    GRANT SELECT ON ipos_sa.* TO 'ipospu_user'@'localhost';
#    GRANT SELECT ON ipos_ca.* TO 'ipospu_user'@'localhost';
# 6. Run sql/ipos_pu_schema.sql to create tables
# 7. Run sql/ipos_pu_seed_data.sql to populate test data

db.url=jdbc:mysql://localhost:3306/ipos_pu
db.user=ipospu_user
db.password=your_password_here

# Cross-subsystem database access (shared DB approach)
db.sa.url=jdbc:mysql://localhost:3306/ipos_sa
db.ca.url=jdbc:mysql://localhost:3306/ipos_ca
